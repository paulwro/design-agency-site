{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/purkiss", "destination": "https://paulwro-surveys.vercel.app/purkiss" },
    { "source": "/purkiss/:path*", "destination": "https://paulwro-surveys.vercel.app/purkiss/:path*" },
    { "source": "/_next/:path*", "destination": "https://paulwro-surveys.vercel.app/_next/:path*" },
    { "source": "/((?!assets/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
